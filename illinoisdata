import pandas as pd

# Load the illinois.csv file into a pandas DataFrame
df = pd.read_csv('illinois.csv')

# Display the first 5 rows of the DataFrame
print(df.head())

import matplotlib.pyplot as plt
import seaborn as sns
import re

# Clean column names by stripping whitespace
df.columns = df.columns.str.strip()

# Filter out the 'Total Nonfarm' row, as it's an aggregate and can obscure individual industry trends
# We will focus on specific industries.
industries_df = df[df['Industry Title'].str.strip() != 'Total Nonfarm'].copy()

# Identify columns that represent months (e.g., 'Jan-90', 'Dec-25')
month_year_pattern = re.compile(r'^[A-Za-z]{3}-\d{2}$', re.IGNORECASE)
potential_month_cols = [col for col in industries_df.columns if month_year_pattern.match(col)]

# Find the starting point for the visualization as requested (Feb-90)
try:
    start_col_index = potential_month_cols.index('Feb-90')
    selected_month_cols = potential_month_cols[start_col_index:]
except ValueError:
    # Fallback: if 'Feb-90' is not found, plot all identified month columns
    print("Warning: 'Feb-90' column not found. Plotting all available month-year columns.")
    selected_month_cols = potential_month_cols

# Select only the 'Industry Title' and the chosen month columns for plotting
plot_df = industries_df[['Industry Title'] + selected_month_cols]

# Melt the DataFrame from wide to long format for easier plotting with seaborn
melted_df = plot_df.melt(id_vars=['Industry Title'], var_name='Month', value_name='Employment')

# Clean the 'Employment' column: remove commas and convert to numeric. Coerce errors to NaN.
melted_df['Employment'] = melted_df['Employment'].str.replace(',', '', regex=False)
melted_df['Employment'] = pd.to_numeric(melted_df['Employment'], errors='coerce')

# Convert 'Month' column to datetime objects for proper time series plotting
melted_df['Month'] = pd.to_datetime(melted_df['Month'], format='%b-%y')

# Drop rows where 'Employment' could not be converted (NaN values)
melted_df.dropna(subset=['Employment'], inplace=True)

# Create the line plot
plt.figure(figsize=(16, 9)) # Adjust figure size for better readability
sns.lineplot(data=melted_df, x='Month', y='Employment', hue='Industry Title', linewidth=1.5)

plt.title('Illinois Industry Employment Trends (Feb 1990 - Last Available Month)', fontsize=18)
plt.xlabel('Date', fontsize=14)
plt.ylabel('Employment', fontsize=14)
plt.legend(title='Industry', bbox_to_anchor=(1.02, 1), loc='upper left', borderaxespad=0.) # Place legend outside the plot
plt.grid(True, linestyle='--', alpha=0.7)
plt.xticks(rotation=45, ha='right') # Rotate x-axis labels for better readability
plt.tight_layout() # Adjust layout to prevent labels/legend from being cut off
plt.show()

